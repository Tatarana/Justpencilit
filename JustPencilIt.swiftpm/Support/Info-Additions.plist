<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSFaceIDUsageDescription</key>
    <string>Usado para desbloquear cadernos e coleções protegidas.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Usado para gravar memos de áudio nos seus cadernos.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Usado para transcrever seus memos de áudio em texto, no próprio aparelho.</string>
    <!-- Criptografia usada: a proteção de arquivos do próprio iOS (Data
         Protection), HTTPS, e a sincronização com o celular cifrada com
         algoritmos padrão (AES-GCM e HKDF) do CryptoKit da Apple, só para
         proteger os dados do próprio usuário. Nada de algoritmo próprio.
         REVISAR antes de enviar à App Store: confirmar que esse uso continua
         isento nas regras de exportação; se não, trocar para true e
         preencher a documentação no App Store Connect. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
