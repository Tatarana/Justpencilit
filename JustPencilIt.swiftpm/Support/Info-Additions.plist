<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSFaceIDUsageDescription</key>
    <string>Usado para desbloquear cadernos e coleções protegidas.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Usado para gravar memos de áudio nos seus cadernos.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Usado para transcrever seus memos de áudio em texto, no próprio aparelho.</string>
    <!-- Só usamos a proteção de arquivos padrão do próprio iOS (Data
         Protection), não uma criptografia própria/custom — isso conta como
         isento pelas regras de exportação dos EUA, então já respondemos
         "não" aqui pra não precisar confirmar manualmente a cada envio. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
